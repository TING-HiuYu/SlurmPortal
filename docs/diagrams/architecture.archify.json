 "cards": [
  {
   "dot": "cyan",
   "title": "One codebase",
   "items": [
    "master, slave, gateway and hook are Go programs in cmd/",
    "the master runs as WebAssembly on a Cloudflare Worker, or natively in a container"
   ]
  },
  {
   "dot": "rose",
   "title": "Trust boundaries",
   "items": [
    "Browsers reach the API over HTTPS through Access or Caddy",
    "Machines use client certificates on the sync endpoint only",
    "Gateway tickets and SSH certificates last 5 minutes"
   ]
  },
  {
   "dot": "emerald",
   "title": "Sync model",
   "items": [
    "the master publishes a hash of the snapshot (DNS, or HTTPS)",
    "a slave downloads the snapshot only when the hash changes",
    "browsers read live status from the status store with presigned links"
   ]
  }
 ]
