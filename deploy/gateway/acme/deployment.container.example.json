  "reload_go": {"argv": ["docker", "exec", "-i", "REPLACE_CONTAINER_NAME", "python3", "-", "hup"], "stdin_file": "/usr/local/libexec/go-ldap-admin/acme/reload_gateway.py"},
  "reload_nginx": {"argv": ["docker", "exec", "REPLACE_CONTAINER_NAME", "nginx", "-s", "reload", "-c", "/etc/go-ldap-admin/web-access-gateway/nginx.conf"]},
  "endpoints": [{"host": "127.0.0.1", "port": 19934}, {"host": "127.0.0.1", "port": 7000}]
