  "source_key": "/var/lib/go-ldap-admin-acme/site/config/live/login.example.org/privkey.pem",
  "target_certificate": "/runtime/site/tls/https.crt.pem",
  "target_key": "/runtime/site/tls/https.key.pem",
  "protected_paths": ["/runtime/site/main-client.crt.pem", "/runtime/site/main-client.key.pem"],
  "state_directory": "/var/lib/go-ldap-admin-acme/site/deployment-state",
  "trust_store": "/etc/ssl/certs/ca-certificates.crt",
  "minimum_remaining_seconds": 604800,
  "verification_timeout_seconds": 20,
  "owner_uid": null,
