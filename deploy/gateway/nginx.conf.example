# Standalone configuration example. Merge http-level maps/log_format and the
# server into an existing Nginx deliberately; do not overwrite a running config.
# gateway.example.org is the example deployment hostname: replace BOTH server_name
# and proxy_ssl_name if the public certificate uses another DNS name.
# Verify the local OS CA bundle path before use. No insecure upstream TLS mode.
worker_processes auto;
pid /run/go-ldap-admin-web-access-nginx/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    map $http_upgrade $gateway_connection {
        default upgrade;
        "" close;
    }

    map $http_origin $gateway_origin_allowed {
        default 0;
        "https://old-portal.example.org" 1;
    }

    map $gateway_origin_allowed $gateway_cors_origin {
        default "";
        1 "https://old-portal.example.org";
    }

    map $gateway_origin_allowed $gateway_cors_credentials {
        default "";
        1 "true";
    }

    # Presence only. Go verifies every dedicated JWT, its owner/cluster/scope
    # and expiry; a nonempty malformed Bearer or cookie never becomes trusted.
    map $http_authorization $gateway_has_bearer {
        default 0;
        "~^Bearer[[:space:]]+[^[:space:]]+$" 1;
    }

    # Use the raw Cookie header: the __Host cookie name contains a hyphen and
    # must not be interpolated as an invalid Nginx $cookie_* variable name.
    map $http_cookie $gateway_has_cookie {
        default 0;
        "~(?:^|;[[:space:]]*)__Host-hpc_gateway_jwt=[^;[:space:]]+" 1;
    }

    map "$gateway_has_bearer:$gateway_has_cookie" $gateway_has_credentials {
        default 0;
        "1:0" 1;
        "0:1" 1;
        "1:1" 1;
    }

    map $request_method $gateway_is_options {
        default 0;
        OPTIONS 1;
    }

    # OPTIONS is answered here only for the exact allowed Origin. Every other
    # request needs a Bearer or cookie, including the cookie-bootstrap POST.
    map "$gateway_is_options:$gateway_origin_allowed:$gateway_has_credentials" $gateway_gate {
        default deny;
        "1:1:0" preflight;
        "1:1:1" preflight;
        "0:0:1" proxy;
        "0:1:1" proxy;
    }

    map $uri $gateway_log_path {
        default $uri;
        ~^/v1/downloads/ "/v1/downloads/[redacted]";
    }

    # Never log query strings, request bodies, Authorization, Cookie or Referer.
    log_format gateway_safe '$remote_addr $request_method $gateway_log_path '
                            '$status $body_bytes_sent';

    server {
        listen 19933 ssl;
        server_name gateway.example.org;

        ssl_certificate /etc/go-ldap-admin/web-access-gateway/https.crt.pem;
        ssl_certificate_key /etc/go-ldap-admin/web-access-gateway/https.key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        access_log /var/log/nginx/web-access-gateway.access.log gateway_safe;
        client_max_body_size 128k;
        client_header_timeout 10s;
        client_body_timeout 30s;
        keepalive_timeout 60s;

        # Server-rewrite return rejects missing credentials before location/body
        # processing. These guards only return; they never rewrite/proxy in if.
        if ($gateway_gate = deny) {
            return 403;
        }

        add_header Access-Control-Allow-Origin $gateway_cors_origin always;
        add_header Access-Control-Allow-Credentials $gateway_cors_credentials always;
        add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
        add_header Vary Origin always;

        # The completion listener is exclusively 127.0.0.1:19935. Neither it
        # nor the Go-only local health endpoint is exposed by this proxy.
        location ^~ /v1/completions/ {
            return 403;
        }
        location = /healthz {
            return 403;
        }

        location /v1/ {
            if ($gateway_gate = preflight) {
                return 204;
            }

            # Avoid duplicate CORS headers when Go returns its own origin gate.
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;

            proxy_pass https://127.0.0.1:19934;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_verify_depth 5;
            proxy_ssl_server_name on;
            proxy_ssl_name gateway.example.org;

            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $gateway_connection;
            proxy_connect_timeout 10s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
            proxy_request_buffering off;
        }

        location / {
            return 403;
        }
    }
}
