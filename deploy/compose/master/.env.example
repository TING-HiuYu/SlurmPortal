# Copied to .env and filled in by ./init.sh. Keep .env private: it holds the portal's secrets.

# --- Where the portal is reached ------------------------------------------------------------
# The host name users type in the browser. Caddy gets an HTTPS certificate for it automatically
# when it is a public DNS name pointing at this machine with ports 80 and 443 open.
PORTAL_HOST=portal.example.org
HTTP_PORT=80
HTTPS_PORT=443
# Slaves and gateways connect to this port with client certificates (open it to the clusters only).
SYNC_PORT=8443
# The containers run as this user; ./init.sh sets it to yours so ./data stays yours.
PORTAL_UID=10001
PORTAL_GID=10001

# --- Directory layout of the accounts -------------------------------------------------------
LDAP_BASE_DN=dc=example,dc=org
LDAP_USER_DN=ou=people,dc=example,dc=org
AUTH_ISSUER=slurm-portal
AUTH_AUDIENCE=slurm-portal-api

# --- Features ---------------------------------------------------------------------------------
PLUGINS_ENABLED=current-status,cluster-status,resource-status,resource-monitor,job-notification,mail-pool,diagnostics
AUDIT_ENABLED=true
AUDIT_MAX_RECORDS=200000
# One entry per cluster; ./add-cluster.sh adds them. Example:
# CLUSTERS=[{"id":"cluster1","name":"Cluster 1","fingerprint":"<sha256 of its client certificate>"}]
CLUSTERS=[]
# Every slave and gateway certificate allowed on the sync port (SHA-256, comma-separated).
SYNC_CLIENT_FINGERPRINTS=

# --- First administrator (remove the password after the first start) -------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__GENERATED__

# --- Secrets (generated by ./init.sh) -----------------------------------------------------------
JWT_KEYS=__GENERATED__
JWT_ACTIVE_KID=k1
PKI_MASTER_KEY=__GENERATED__
STATUS_BUCKET=slurm-portal-status
S3_ACCESS_KEY=__GENERATED__
S3_SECRET_KEY=__GENERATED__
