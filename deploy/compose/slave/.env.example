# Copy to .env. The slave runs as this user, so its config and secrets (mode 0600) must be owned by it.
PORTAL_UID=10001
PORTAL_GID=10001
# Where the slave writes the SSH trust files on this host; login nodes' sshd must read this
# directory (TrustedUserCAKeys <dir>/current/ssh/trusted-user-ca-keys.pub).
TRUST_DIR=./data/trust
