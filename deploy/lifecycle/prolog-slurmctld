#!/bin/sh
# Controller hook only. Preserve existing compute-node Prolog/TaskProlog hooks.
# A missing optional monitoring helper must not block Slurm allocation.
[ -x /usr/local/libexec/go-ldap-admin/slurm-lifecycle-hook ] || exit 0
exec /usr/local/libexec/go-ldap-admin/slurm-lifecycle-hook \
  --config /etc/go-ldap-admin/lifecycle-hook.yaml \
  --event starting
